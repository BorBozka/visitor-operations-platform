{
  "name": "visitor-management-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @visitor-management/api dev",
    "build": "tsc -b && vite build",
    "build:api": "pnpm --filter @visitor-management/api build",
    "build:all": "pnpm build && pnpm build:api",
    "start:api": "pnpm --filter @visitor-management/api start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "typecheck:api": "pnpm --filter @visitor-management/api typecheck",
    "test:api": "pnpm --filter @visitor-management/api test",
    "db:generate": "pnpm --filter @visitor-management/api db:generate",
    "db:migrate": "pnpm --filter @visitor-management/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @visitor-management/api db:migrate:deploy",
    "db:seed": "pnpm --filter @visitor-management/api db:seed",
    "db:bootstrap": "pnpm --filter @visitor-management/api db:bootstrap"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "write-excel-file": "^4.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "happy-dom": "^20.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
