# Frontend (Vite) environment. Copy to `.env.local` for local overrides.
# Vite only exposes VITE_-prefixed variables to the app.

# Base URL of the Fastify backend API, including the `/api` path segment. Set this
# before the Vite production build because VITE_ variables are embedded at build time.
# When unset the app falls back to http://localhost:3001/api, which matches the
# local backend started with `pnpm dev:api`.
VITE_API_BASE_URL=http://localhost:3001/api
