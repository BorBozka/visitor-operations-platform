# Frontend (Vite) environment. Copy to `.env.local` for local overrides.
# Vite only exposes VITE_-prefixed variables to the app.

# Base URL of the Fastify backend API, including the `/api` path segment. Set this
# before the Vite production build because VITE_ variables are embedded at build time.
# When unset the app falls back to http://localhost:3001/api, which matches the
# local backend started with `pnpm dev:api`.
VITE_API_BASE_URL=http://localhost:3001/api

# Development/demo only: set to `true` to show the four demo role buttons (Admin, Yönetici,
# Çalışan, Güvenlik) on the login screen. The buttons only fill the login form; authentication
# still uses the normal LOCAL `/api/auth/login` flow. Leave unset in production builds — any
# other value keeps the buttons out of the rendered page. The matching accounts exist only in
# the development-only seed (`NODE_ENV=development` + `DEMO_SEED_ENABLED=true`).
# VITE_DEMO_LOGIN=true
