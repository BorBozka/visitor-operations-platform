# Runtime mode. Production enables Secure cookies and should use production-managed secrets.
NODE_ENV=development

# Public API port and the exact frontend origin allowed by CORS. WEB_ORIGIN is also
# used to build public invitation URLs; do not include a trailing path.
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Prisma SQL Server connection URL. Choose one example and supply it through the
# environment/secret manager; never commit a real password.
# Windows integrated security:
# DATABASE_URL="sqlserver://localhost:1433;database=visitor_operations;integratedSecurity=true;trustServerCertificate=true;"
# SQL authentication:
# DATABASE_URL="sqlserver://localhost:1433;database=visitor_operations;user=sa;password={replace-me};encrypt=true;trustServerCertificate=true;"
DATABASE_URL=

# Opaque HttpOnly server-side session cookie name and lifetime. Keep the cookie name
# stable for a deployment; rotating it signs every browser session out.
SESSION_COOKIE_NAME=bplas_session
SESSION_TTL_HOURS=8

# Demo seed is development-only and additionally refuses to run unless
# NODE_ENV=development. Enable it intentionally for a disposable/local database.
DEMO_SEED_ENABLED=false

# Development/test default: `log` does not send email or log invitation tokens/URLs.
# Production must set EMAIL_DELIVERY_MODE=smtp and supply every SMTP/sender field below.
EMAIL_DELIVERY_MODE=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@example.test
# MAIL_FROM_NAME=Ziyaretçi Operasyonları

# Login attempts per minute per IP (default 10). Raise for E2E runs.
# AUTH_RATE_LIMIT_MAX=500
